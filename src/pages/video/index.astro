---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryGroup from '../../components/CategoryGroup.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { resolveCoverImage } from '../../utils/cover';
import { groupByCategory } from '../../utils/projects';

const allProjects = await getCollection('projects');
const projects = allProjects.filter((p) => p.data.tab === 'video');

// No fixed category order for this tab yet: while this array is empty the
// categories come out in the order the projects are collected. Add category
// names here once the tab has content and the grouping matters.
const categoryOrder: string[] = [];
const groups = groupByCategory(projects, categoryOrder);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Video · NABA - Virtual Studio" activeTab="video">
  {groups.map((group) => (
    <CategoryGroup title={group.category}>
      {group.items.map((project) => (
        <ProjectCard
          title={project.data.title}
          slug={project.slug}
          cover={resolveCoverImage(project.data.cover ?? project.slug, base)}
          status={project.data.status}
        />
      ))}
    </CategoryGroup>
  ))}

  {projects.length === 0 && (
    <div class="text-center py-24">
      <p class="text-text-secondary text-sm">No videos yet.</p>
      <p class="text-text-muted text-xs mt-2">Add them by creating files in <code class="px-1.5 py-0.5 bg-card-bg border border-border-subtle rounded text-text-secondary">src/content/projects/</code> with <code class="px-1.5 py-0.5 bg-card-bg border border-border-subtle rounded text-text-secondary">tab: "video"</code> and a <code class="px-1.5 py-0.5 bg-card-bg border border-border-subtle rounded text-text-secondary">youtubeId</code>.</p>
    </div>
  )}

  <ProjectModal projects={projects} />
</BaseLayout>
