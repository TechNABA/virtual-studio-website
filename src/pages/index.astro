---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryGroup from '../components/CategoryGroup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { resolveCoverImage } from '../utils/cover';
import { groupByCategory } from '../utils/projects';

const allProjects = await getCollection('projects');
const projects = allProjects.filter((p) => p.data.tab === 'in-camera-vfx');

// Category order for this tab. Categories not listed here still work, they just
// appear after the listed ones.
const categoryOrder = ['Media System', 'Camera', 'Camera Tracking', 'Stage Control', 'Previz', 'Pipeline'];
const groups = groupByCategory(projects, categoryOrder);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="In-Camera VFX · NABA - Virtual Studio" activeTab="in-camera-vfx">
  {groups.map((group) => (
    <CategoryGroup title={group.category}>
      {group.items.map((project) => (
        <ProjectCard
          title={project.data.title}
          slug={project.slug}
          cover={resolveCoverImage(project.data.cover ?? project.slug, base)}
          status={project.data.status}
        />
      ))}
    </CategoryGroup>
  ))}

  {projects.length === 0 && (
    <div class="text-center py-24">
      <p class="text-text-secondary text-sm">No In-Camera VFX projects yet.</p>
      <p class="text-text-muted text-xs mt-2">Add them by creating files in <code class="px-1.5 py-0.5 bg-card-bg border border-border-subtle rounded text-text-secondary">src/content/projects/</code> with <code class="px-1.5 py-0.5 bg-card-bg border border-border-subtle rounded text-text-secondary">tab: "in-camera-vfx"</code>.</p>
    </div>
  )}

  <ProjectModal projects={projects} />
</BaseLayout>
